"""xc2064pack: configuration as text (format: see xc2064db/config.py, from nextpnr with --vopt out= or from
xc2064unpack) -> XC2064 bitstream as .RBT (exactly in the layout of XACT) or .BIT.

    xc2064pack design.txt -o design.rbt [--package PC68|PD48|PC44|PG68] [--design NAME]

Whatever the text does not specify is in XACT's default state (unused CLBs and IOBs, options). The tool derives
the direction of the repowering buffers from the routing if the text has no bidi lines or contains
"bidi auto". Exits with an error on unknown names or codes and if the bitstream cannot be decoded again
without errors.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from xc2064db import bitstream, config, graph, packages  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("text", help="configuration as text")
    ap.add_argument("-o", "--output", required=True, help=".rbt or .bit")
    ap.add_argument("--package", help="package for the RBT header (default: from the text file, otherwise PC68)")
    ap.add_argument("--design", help="name in the RBT header (default: name of the output file)")
    ap.add_argument("--compare", metavar="BITSTREAM", help="compare the result bit for bit with this bitstream")
    args = ap.parse_args()

    db = config.Database()
    lines = config.parse_text(open(args.text, encoding="utf-8").read())
    try:
        raw = config.encode(db, lines)
    except ValueError as e:
        sys.exit("xc2064pack: %s" % e)
    bidi = [l for l in lines if l.kind == "bidi"]
    auto = not bidi or any(l.name == "auto" for l in bidi)
    if auto:  # direction of the buffers from the routing
        gs = graph.Graph(db.entries, db.lines, split_bidi=True)
        try:
            for down, code in gs.bidi_directions(raw):
                if code is not None:
                    raw[down.bits[0]] = code
        except ValueError as e:
            sys.exit("xc2064pack: %s" % e)
    n_bidi = sum(1 - raw[b] for b in db.bidi_bit.values())
    items, problems = config.decode(db, raw)
    if problems:
        sys.exit("xc2064pack: the bitstream cannot be decoded without errors: %s" % "; ".join(problems[:5]))

    package = (args.package or next((l.name for l in lines if l.kind == "package"), "PC68")).upper()
    if package not in packages.PACKAGES:
        sys.exit("xc2064pack: unknown package %s (%s)" % (package, ", ".join(packages.PACKAGES)))
    design = args.design or os.path.splitext(os.path.basename(args.output))[0]
    if args.output.upper().endswith(".BIT"):
        open(args.output, "wb").write(bitstream.write_bit(raw))
    else:
        open(args.output, "w", newline="").write(bitstream.write_rbt(raw, design, "2064" + package.upper()))
    print("xc2064pack: %s -> %s: %d programmed bits, %d buffers down/right%s" % (
        os.path.basename(args.text), os.path.basename(args.output), raw.count(0), n_bidi,
        " (from the routing)" if auto else ""), file=sys.stderr)
    if args.compare:
        ref = bitstream.read(args.compare).raw
        diff = [i for i in range(len(ref)) if ref[i] != raw[i]]
        print("xc2064pack: comparison with %s: %s" % (os.path.basename(args.compare), "bit-exact" if not diff else
              "%d bits differ, e.g. %s" % (len(diff), ", ".join(db.entries[i].text for i in diff[:3]))),
              file=sys.stderr)
        if diff:
            sys.exit(1)


if __name__ == "__main__":
    main()
