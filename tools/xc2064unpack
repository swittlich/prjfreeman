#!/usr/bin/env python3
"""xc2064unpack: XC2064 bitstream (.BIT or .RBT from XACT) -> configuration as text (format: see
xc2064db/config.py). Exits with an error if a programmed bit or a mux code is not in the bit map.

    xc2064unpack COUNTER.BIT [-o COUNTER.txt]
"""
import argparse
import collections
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from xc2064db import bitstream, config, graph  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("bitstream", help=".BIT or .RBT")
    ap.add_argument("-o", "--output", help="text file (default: stdout)")
    args = ap.parse_args()

    bs = bitstream.read(args.bitstream)
    db = config.Database()
    items, problems = config.decode(db, bs.raw)
    text = config.format_text(items, "%s (%s)" % (os.path.basename(args.bitstream), bs.fmt))
    if args.output:
        with open(args.output, "w") as f:
            f.write(text)
    else:
        sys.stdout.write(text)

    count = collections.Counter(it.kind for it in items)
    zeros = sum(1 for b in bs.raw if b == 0)
    print("xc2064unpack: %s: %d programmed bits; %s; %d problems" % (
        os.path.basename(args.bitstream), zeros, ", ".join("%d %s" % (count[k], k) for k in
                                                          ("mux", "pip", "switch", "bidi", "clb", "iob", "bit")),
        len(problems)), file=sys.stderr)
    # routing graph of the model (xc2064db.graph): which programmed pips and switch connections it knows
    by_bit = graph.Graph(db.entries, db.lines).by_bit()
    conns = [it for it in items if it.kind in ("pip", "switch")]
    outside = [it for it in conns if not any(b in by_bit for b in it.bits)]
    print("xc2064unpack: %d of %d pips and switch connections in the routing graph%s" % (
        len(conns) - len(outside), len(conns),
        " (missing: %s)" % " ".join(it.name for it in outside[:4]) if outside else ""),
        file=sys.stderr)
    for n in bs.notes:
        print("xc2064unpack: note: " + n, file=sys.stderr)
    for p in problems:
        print("xc2064unpack: ERROR: " + p, file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
