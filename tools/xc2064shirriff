"""xc2064shirriff: cross-check of a bitstream with Shirriff's decoder (shirriff-xc2064/html, in QuickJS without a
browser, see xc2064db/shirriff.py). Shirriff's code reads the RBT file itself and decodes it; the result must
match our own decoding: the interior of each CLB (base, inputs, truth tables, X/Y, Q, set/reset,
clock), the selected sources of the CLB inputs, O, T and K muxes of the IOBs, latched inputs, pips,
switch connections and buffers.

    xc2064shirriff design.rbt [more .rbt/.bit ...]

Exits with an error if anything deviates. Needs the Python package quickjs (.devcontainer/requirements.txt).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from xc2064db import bitstream, config, shirriff  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("bitstreams", nargs="+", help=".rbt or .bit")
    ap.add_argument("-v", "--verbose", action="store_true", help="all deviations instead of the first 10")
    args = ap.parse_args()
    if not shirriff.available():
        sys.exit("xc2064shirriff: Python package quickjs is missing (pip install quickjs)")
    db = config.Database()
    dec = shirriff.Decoder()
    failed = 0
    for path in args.bitstreams:
        raw = bitstream.read(path).raw
        n, bad = shirriff.compare(db, raw, dec.decode(shirriff.rbt_text(path)))
        counts = ", ".join("%d %s" % (v, k) for k, v in n.items())
        print("xc2064shirriff: %s: %s; %s" % (os.path.basename(path), counts,
                                             "same as Shirriff" if not bad else "%d deviations" % len(bad)),
              file=sys.stderr)
        for b in bad if args.verbose else bad[:10]:
            print("  " + b, file=sys.stderr)
        failed += bool(bad)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
