# Pin assignment for blinky.v: set_io <port> <PLCC68 pin>
# P9 has the global clock buffer GCLK. The other pins are next to each other on the top edge.
set_io clk     P9
set_io rst     P8
set_io leds[0] P7
set_io leds[1] P6
set_io leds[2] P5
set_io leds[3] P4
set_io leds[4] P3
set_io leds[5] P2
set_io leds[6] P68
set_io leds[7] P67
