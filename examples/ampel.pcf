# Pin assignment for ampel.v: set_io <port> <PLCC68 pin>
# Clock, reset and push button at the top, the lamps on the right
set_io clk     P9
set_io rst     P8
set_io req     P7
set_io red     P59
set_io yellow  P58
set_io green   P57
set_io walk    P56
set_io waiting P55
