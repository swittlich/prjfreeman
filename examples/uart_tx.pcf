# Pin assignment for uart_tx.v: set_io <port> <PLCC68 pin>
# Clock, reset, start and data at the top, tx and busy on the right
set_io clk     P9
set_io rst     P8
set_io start   P7
set_io data[0] P6
set_io data[1] P5
set_io data[2] P4
set_io data[3] P3
set_io data[4] P2
set_io data[5] P68
set_io data[6] P67
set_io data[7] P66
set_io tx      P59
set_io busy    P58
